# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/test-results/
/playwright-report/
# Accessibility-tree dumps written by the Playwright CLI. Scratch output of a
# tool run, never part of a change; one was swept into a PR by `git add -A`
# on 2026-09-08 before this line existed.
/.playwright-cli/

# vercel
.vercel

# supabase
supabase/.temp/
!.env.example

# imagery pipeline
/.imagery-cache/
