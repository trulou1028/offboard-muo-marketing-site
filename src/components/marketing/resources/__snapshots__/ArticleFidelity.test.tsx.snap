rue"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"></path><path d="M20 3v4"></path><path d="M22 5h-4"></path><path d="M4 17v2"></path><path d="M5 18H3"></path></svg><span><strong>Lumo</strong><small>The guide that knows your situation.</small></span></a><a href="/integrations"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plug" aria-hidden="true"><path d="M12 22v-5"></path><path d="M9 8V2"></path><path d="M15 8V2"></path><path d="M18 8v5a4 4 0 0 1-4 4h-4a4 4 0 0 1-4-4V8Z"></path></svg><span><strong>Integrations</strong><small>Use Offboard from the AI you already use.</small></span></a></div><div class="mh-nav-column"><span class="mh-nav-heading">The work</span><a href="/job-search"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-briefcase" aria-hidden="true"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path><rect width="20" height="14" x="2" y="6" rx="2"></rect></svg><span><strong>Job Search</strong><small>The whole search as one system.</small></span></a><a href="/layoff-support"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-life-buoy" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m4.93 4.93 4.24 4.24"></path><path d="m14.83 9.17 4.24-4.24"></path><path d="m14.83 14.83 4.24 4.24"></path><path d="m9.17 14.83-4.24 4.24"></path><circle cx="12" cy="12" r="4"></circle></svg><span><strong>Layoff &amp; Benefits</strong><small>Deadlines, coverage, and runway.</small></span></a></div></div></div><a href="/employers">For Employers</a><a href="/pricing">Pricing</a><div class="mh-nav-group"><button type="button" class="mh-nav-trigger" aria-expanded="false" aria-controls="_reactId_-panel" data-active=""><span>Resources</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div class="mh-nav-panel" id="_reactId_-panel" hidden="" data-columns="2"><a class="mh-nav-feature" href="https://newsletter.offboard.co"><strong>The Offboard Newsletter</strong><span class="mh-nav-feature-visual"><img alt="" loading="eager" decoding="async" data-nimg="fill" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="300px" srcset="/_next/image?url=%2Fmarketing%2Fhomepage%2Fraw%2Fhero-real-life.webp&amp;w=32&amp;q=75 32w, /_next/image?url=%2Fmarketing%2Fhomepage%2Fraw%2Fhero-real-life.webp&amp;w=48&amp;q=75 48w, /_next/image?url=%2Fmarketing%2Fhomepage%2Fraw%2Fhero-real-life.webp&amp;w=64&amp;q=75 64w, /_next/image?url=%2Fmarketing%2Fhomepage%2Fraw%2Fhero-real-life.webp&amp;w=96&amp;q=75 96w, /_next/image?url=%2Fmarketing%2Fhomepage%2Fraw%2Fhero-real-life.webp&amp;w=128&amp;q=75 128w, /_next/image?url=%2Fmarketing%2Fhomepage%2Fraw%2Fhero-real-life.webp&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fmarketing%2Fhomepage%2Fraw%2Fhero-real-life.webp&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fmarketing%2Fhomepage%2Fraw%2Fhero-real-life.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fmarketing%2Fhomepage%2Fraw%2Fhero-real-life.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fmarketing%2Fhomepage%2Fraw%2Fhero-real-life.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fmarketing%2Fhomepage%2Fraw%2Fhero-real-life.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fmarketing%2Fhomepage%2Fraw%2Fhero-real-life.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fmarketing%2Fhomepage%2Fraw%2Fhero-real-life.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fmarketing%2Fhomepage%2Fraw%2Fhero-real-life.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fmarketing%2Fhomepage%2Fraw%2Fhero-real-life.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Fmarketing%2Fhomepage%2Fraw%2Fhero-real-life.webp&amp;w=3840&amp;q=75"></span><span class="mh-nav-feature-kicker">The newsletter</span><small>Weekly job-market analysis and honest takes on tech hiring. 5,000+ subscribers.</small><span class="mh-nav-feature-cta">Subscribe free <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span></a><div class="mh-nav-column"><span class="mh-nav-heading">Resources</span><a aria-current="page" href="/resources"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open" aria-hidden="true"><path d="M12 7v14"></path><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"></path></svg><span><strong>Guides</strong><small>Practical answers, checked by people.</small></span></a><a href="/privacy-security"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg><span><strong>Privacy &amp; Security</strong><small>Who can see your record, and who cannot.</small></span></a></div><div class="mh-nav-column"><span class="mh-nav-heading">Company</span><a href="/about"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg><span><strong>About</strong><small>Why Offboard exists, and who is behind it.</small></span></a><a href="/intake"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg><span><strong>Visit Us</strong><small>Talk to a person, online or in Concord.</small></span></a><a href="https://join.slack.com/t/offboardco/shared_invite/zt-34fsjpgfn-BcbibJ3d86P5RztYnHsA9w"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg><span><strong>Slack Community</strong><small>People searching alongside you.</small></span></a><a href="mailto:hello@offboard.co"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg><span><strong>Contact</strong><small>hello@offboard.co. A human reads it.</small></span></a></div></div></div></nav><div class="mh-header-actions"><details class="mh-mobile-menu"><summary>Menu</summary><div><div class="mh-mobile-group"><strong>Product</strong><a href="/career-context">Career Context</a><a href="/lumo">Lumo</a><a href="/integrations">Integrations</a><a href="/job-search">Job Search</a><a href="/layoff-support">Layoff &amp; Benefits</a></div><a href="/employers">For Employers</a><a href="/pricing">Pricing</a><div class="mh-mobile-group"><strong>Resources</strong><a href="https://newsletter.offboard.co">The Offboard Newsletter</a><a aria-current="page" href="/resources">Guides</a><a href="/privacy-security">Privacy &amp; Security</a><a href="/about">About</a><a href="/intake">Visit Us</a><a href="https://join.slack.com/t/offboardco/shared_invite/zt-34fsjpgfn-BcbibJ3d86P5RztYnHsA9w">Slack Community</a><a href="mailto:hello@offboard.co">Contact</a></div><a href="https://app.offboard.co/auth?tab=signin">Sign In</a></div></details><a class="mh-sign-in" href="https://app.offboard.co/auth?tab=signin">Sign In</a><a class="mh-primary-cta" href="https://app.offboard.co/auth?tab=signup"><span>Get started free</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></header><main id="main-content"><article class="mh-article mh-section"><div class="mh-article-header"><a class="mh-article-back" href="/resources"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg> All guides</a><span class="mh-kicker is-lime">Guides</span><h1>Rebuild your resume after a layoff</h1><div class="mh-article-meta"><span class="mh-article-meta-reading"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg> 8 min read</span></div></div><div class="mh-article-body" data-guide-article="true"><h2 class="mh-article-h2">First, settle how you talk about the layoff</h2><p class="mh-article-p">Layoffs are common and recruiters know it. You do not owe an explanation on the resume itself. Keep your dates honest, and if you want context, a short, neutral line in a cover note or LinkedIn is plenty: a role eliminated in a company-wide reduction is a fact, not a flaw. Spend your energy on the work you did, not on defending the exit.</p><h2 class="mh-article-h2">Build one strong base resume</h2><p class="mh-article-p">Trying to keep ten slightly different resumes in sync is how things go stale. Instead, build a single, complete base, then tailor a copy per role. Your base should include:</p><ul class="mh-article-list"><li>A short header that names the role you are targeting, not a generic title.</li><li>Every relevant role with dates, scope, and the size of what you owned.</li><li>A deep bank of accomplishment bullets, more than any one application needs.</li><li>Skills and tools stated plainly, so both humans and keyword filters can find them.</li></ul><h2 class="mh-article-h2">Lead with outcomes, not duties</h2><p class="mh-article-p">The difference between a forgettable bullet and a strong one is whether it shows a result. A duty describes what you were assigned. An outcome shows what changed because you were there. Use a simple shape: action, then impact, then a number wherever you honestly can.</p><div class="mh-article-callout"><div class="mh-article-callout-title">Weak vs. strong</div><p>Weak: “Responsible for managing the onboarding process.” Strong: “Redesigned onboarding, cutting time-to-first-value from 14 days to 5 and lifting 30-day retention 12%.”</p></div><p class="mh-article-p">Do not have clean metrics for everything? That is fine. Reach for scale (how many, how large), speed (how much faster), or quality (fewer errors, higher satisfaction). A credible directional result beats a vague responsibility every time.</p><h2 class="mh-article-h2">Tailor each application without starting over</h2><p class="mh-article-p">Tailoring is not rewriting. With a strong base, each application is mostly selection and emphasis:</p><ul class="mh-article-list"><li>Read the job description and note the 5 to 8 things it clearly cares about most.</li><li>Pull the bullets from your base that speak to those priorities, and cut the rest.</li><li>Echo the role's own language for skills you genuinely have, so filters and skimmers catch them.</li><li>Reorder so the most relevant experience sits highest on the page.</li></ul><p class="mh-article-p">Most applicant tracking systems and recruiters scan, they do not read. Tailoring is how you make the relevant ten seconds count, and a base-plus-selection workflow makes it a five-minute job instead of an evening.</p><h2 class="mh-article-h2">Avoid the common traps</h2><ul class="mh-article-list"><li>Stuffing keywords you cannot back up, it falls apart in the interview.</li><li>A dense wall of text, white space and short bullets get read.</li><li>Listing duties for senior roles, at that level, impact is the whole point.</li><li>One resume for every job, generic reads as generic.</li></ul><h2 class="mh-article-h2">Keep it a living document</h2><p class="mh-article-p">Your resume is not a one-time artifact, it is a record you maintain. As outcomes land in the search, callbacks, projects, new metrics, fold them back into the base so the next tailored copy is even stronger. This is exactly the loop Offboard is built around: upload your resume once, then let Resume Tailor reshape it for each role, or paste a job URL and an Application Packet tailors your resume, drafts the cover letter, and preps the interview in one pass, always starting from everything you have already done rather than a blank page.</p></div><div class="mh-article-footer"><a class="mh-section-link" href="/resources">More guides <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></article></main><footer class="mh-site-footer"><div><div><img alt="Offboard" loading="lazy" width="520" height="106" decoding="async" data-nimg="1" class="mh-footer-brand" style="color: transparent;" srcset="/_next/image?url=%2Fmarketing%2Fhomepage%2Foffboard-logo-light.png&amp;w=640&amp;q=75 1x, /_next/image?url=%2Fmarketing%2Fhomepage%2Foffboard-logo-light.png&amp;w=1080&amp;q=75 2x" src="/_next/image?url=%2Fmarketing%2Fhomepage%2Foffboard-logo-light.png&amp;w=1080&amp;q=75"><p>Offboard is the company behind the Modern Unemployment Office, one connected system for benefits, job search, and the work of starting again.</p></div><nav aria-label="Footer navigation"><div><strong>Product</strong><a href="/career-context">Career Context</a><a href="/lumo">Lumo</a><a href="/job-search">Job Search</a><a href="/integrations">Integrations</a><a href="/layoff-support">Layoff &amp; Benefits</a><a href="/pricing">Pricing</a><a href="/resources">Guides</a></div><div><strong>Partners</strong><a href="/employers">For Employers</a></div><div><strong>Company</strong><a href="/about">About</a><a href="/intake">Visit Us</a><a href="mailto:hello@offboard.co">Contact</a></div><div><strong>Legal</strong><a href="/privacy-security">Privacy &amp; Security</a><a href="https://app.offboard.co/privacy">Privacy Policy</a><a href="https://app.offboard.co/terms">Terms</a></div></nav></div><p><span>© 2026 Offboard</span><span>Built for the work between jobs.</span></p></footer></div>"`;

exports[`article fidelity: what-is-an-ai-agent > matches the pre-conversion baseline and has substantial body text 1`] = `"<div class="marketing-homepage mh-page-resources"><a class="mh-skip-link" href="#main-content">Skip to content</a><header class="mh-site-header"><a aria-label="Offboard home" href="/"><img alt="Offboard" loading="eager" width="520" height="106" decoding="async" data-nimg="1" class="mh-brand" style="color: transparent;" srcset="/_next/image?url=%2Fmarketing%2Fhomepage%2Foffboard-logo-light.png&amp;w=640&amp;q=75 1x, /_next/image?url=%2Fmarketing%2Fhomepage%2Foffboard-logo-light.png&amp;w=1080&amp;q=75 2x" src="/_next/image?url=%2Fmarketing%2Fhomepage%2Foffboard-logo-light.png&amp;w=1080&amp;q=75"></a><nav class="mh-site-nav" aria-label="Marketing navigation"><div class="mh-nav-group"><button type="button" class="mh-nav-trigger" aria-expanded="false" aria-controls="_reactId_-panel"><span>Product</span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button><div class="mh-nav-panel" id="_reactId_-panel" hidden="" data-columns="2"><a class="mh-nav-feature" href="/career-context"><strong>Career Context</strong><span class="mh-nav-feature-visual"><img alt="" loading="eager" decoding="async" data-nimg="fill" style="position: absolute; height: 100%; width: 100%; left: 0px; top: 0px; right: 0px; bottom: 0px; color: transparent;" sizes="300px" srcset="/_next/image?url=%2Fmarketing%2Fhomepage%2Frenders%2Fpath-stage.webp&amp;w=32&amp;q=75 32w, /_next/image?url=%2Fmarketing%2Fhomepage%2Frenders%2Fpath-stage.webp&amp;w=48&amp;q=75 48w, /_next/image?url=%2Fmarketing%2Fhomepage%2Frenders%2Fpath-stage.webp&amp;w=64&amp;q=75 64w, /_next/image?url=%2Fmarketing%2Fhomepage%2Frenders%2Fpath-stage.webp&amp;w=96&amp;q=75 96w, /_next/image?url=%2Fmar