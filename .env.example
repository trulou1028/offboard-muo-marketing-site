# Copy to .env.local and fill in. The site's marketing pages still make zero
# backend calls to Supabase from the browser (a test enforces it); the
# /intake form submits through a same-origin Next.js server action instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Server-only. Used by the /intake server action (src/app/intake/actions.ts)
# to insert into intake_submissions with RLS bypassed. NEVER prefix with
# NEXT_PUBLIC_ and never read it from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Used by the /intake server action to send the submitter
# confirmation and team notification emails via the Resend API. Absence is
# handled gracefully: the submission still saves, only the emails are
# skipped (logged, not thrown).
RESEND_API_KEY=
