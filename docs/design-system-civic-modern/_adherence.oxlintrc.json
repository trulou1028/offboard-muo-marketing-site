{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/layout/**",
              "components/navigation/**",
              "components/product/**",
              "ui_kits/marketing/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Inter))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|ai|lumo|onDark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'ai' | 'lumo' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatExchange'] > JSXAttribute > JSXIdentifier[name!=/^(?:floating|width|children|style|key|ref|className|style|children)$/]",
        "message": "<ChatExchange> doesn't accept that prop. Declared props: floating, width, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|dot|children|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: tone, dot, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:photo|status)$/]",
        "message": "<Chip> tone must be one of 'photo' | 'status'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='dot'] > Literal[value!=/^(?:sage|lumo)$/]",
        "message": "<Chip> dot must be one of 'sage' | 'lumo'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:forest|sand|lumo|onDark)$/]",
        "message": "<Eyebrow> tone must be one of 'forest' | 'sand' | 'lumo' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|base|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, base, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InsetBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|contentStyle|key|ref|className|style|children)$/]",
        "message": "<InsetBlock> doesn't accept that prop. Declared props: children, style, contentStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='LumoMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|style|key|ref|className|style|children)$/]",
        "message": "<LumoMark> doesn't accept that prop. Declared props: size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Photo'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|height|chips|chipCorner|imgStyle|children|style|key|ref|className|style|children)$/]",
        "message": "<Photo> doesn't accept that prop. Declared props: src, alt, ratio, height, chips, chipCorner, imgStyle, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Photo'] > JSXAttribute[name.name='chipCorner'] > Literal[value!=/^(?:bottom-left|bottom-right|top-left|top-right)$/]",
        "message": "<Photo> chipCorner must be one of 'bottom-left' | 'bottom-right' | 'top-left' | 'top-right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlanCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|price|cadence|tagline|features|emphasized|action|iconBase|style|key|ref|className|style|children)$/]",
        "message": "<PlanCard> doesn't accept that prop. Declared props: name, price, cadence, tagline, features, emphasized, action, iconBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuestionBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|feature|tone|children|style|key|ref|className|style|children)$/]",
        "message": "<QuestionBlock> doesn't accept that prop. Declared props: question, feature, tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuestionBlock'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:forest|sand|lumo|onDark)$/]",
        "message": "<QuestionBlock> tone must be one of 'forest' | 'sand' | 'lumo' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:band|compact|children|style|contentStyle|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: band, compact, children, style, contentStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='band'] > Literal[value!=/^(?:paper|paperDeep|mist|sand|forestDeep)$/]",
        "message": "<Section> band must be one of 'paper' | 'paperDeep' | 'mist' | 'sand' | 'forestDeep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|columns|note|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: logo, columns, note, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:logo|links|onDark|active|onNavigate|style|key|ref|className|style|children)$/]",
        "message": "<SiteHeader> doesn't accept that prop. Declared props: logo, links, onDark, active, onNavigate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrackerCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|company|location|status|meta|compact|floating|style|key|ref|className|style|children)$/]",
        "message": "<TrackerCard> doesn't accept that prop. Declared props: role, company, location, status, meta, compact, floating, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Triptych'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|height|side|style|key|ref|className|style|children)$/]",
        "message": "<Triptych> doesn't accept that prop. Declared props: children, height, side, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
